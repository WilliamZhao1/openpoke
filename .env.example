# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API key for LLM access
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter model used by all agents (must support tool calling)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional: Maximum output tokens per LLM request (default: 2048)
# OPENROUTER_MAX_TOKENS=2048

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: Persistent data directory (default: server/data)
# Set before starting the backend; restart after changing it.
# Relative paths are resolved from the backend's working directory.
# OPENPOKE_DATA_DIR=/absolute/path/to/openpoke-data

# Optional: Worker discovery strategy (legacy by default during development)
# Set to bounded for a capped recent roster and find_worker; restart after changes.
# OPENPOKE_WORKER_DISCOVERY=bounded

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs
